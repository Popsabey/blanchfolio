---
import Layout from '../../layouts/Layout.astro';
import DemoMedia from '../../components/DemoMedia.astro';
import Footer from '../../components/Footer.astro';
import { allCaseStudies, type CaseStudy } from '../../data/caseStudies';
import rawManifest from '../../data/media-manifest.json';

interface ManifestItem {
  type: 'video' | 'image';
  width: number;
  height: number;
  poster: string;
  mp4?: string;
  webm?: string;
}

const manifest = rawManifest as Record<string, ManifestItem>;

export function getStaticPaths() {
  return allCaseStudies.map((study) => ({
    params: { slug: study.slug },
    props: { study },
  }));
}

interface Props {
  study: CaseStudy;
}

const { study } = Astro.props;

// Specific meta description per case study
const metaDescription =
  study.slug === 'applatchkids'
    ? 'Applatch is a connected parent-and-child experience that helps families build healthier screen-time habits through educational quizzes and smart boundaries.'
    : study.slug === 'chada'
      ? 'Chada disrupts traditional trading by merging intuitive savings mechanics with high-yield decentralized finance, real-time portfolio health, and emotional AI guidance.'
      : study.slug === 'redacted'
        ? '‘Redacted’ is an intelligent food planner and calorie tracking platform using artificial intelligence and data tracking to deliver personalized meal recommendations.'
        : `${study.title} — Case study by Abiodun Popoola.`;
---

<Layout
  title={study.title}
  description={metaDescription}
  image={`/media/${study.hero}.webp`}
>
  <main class="w-full pt-[120px] md:pt-[150px]">
    <!-- Top Back Button: Aligned to container left edge -->
    <div class="w-full flex items-center justify-start">
      <a
        href="/#designs"
        class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-[6px] bg-[#F1F1F1] text-[14px] text-[#262626] font-normal hover:bg-[#E5E5E5] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#4361EE] focus-visible:ring-offset-2 transition-colors duration-150 group"
        aria-label="Back to designs section on homepage"
      >
        <svg
          class="w-4 h-4 text-[#262626] group-hover:-translate-x-0.5 transition-transform duration-150"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="m15 18-6-6 6-6" />
        </svg>
        <span>Back</span>
      </a>
    </div>

    <!-- Centered Header Block -->
    <header class="mt-8 md:mt-12 text-center w-full">
      <h1 class="text-[26px] sm:text-[30px] md:text-[32px] font-semibold text-[#000000] tracking-tight leading-tight max-w-[760px] mx-auto">
        {study.title}
      </h1>
      <div class="mt-3 flex items-center justify-center gap-2 text-[14px] leading-normal text-[#737373]">
        <span>{study.category}</span>
        {
          study.websiteUrl && (
            <a
              href={study.websiteUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-[#4361EE] underline underline-offset-2 hover:opacity-80 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#4361EE] rounded-sm transition-opacity"
            >
              Visit website
            </a>
          )
        }
      </div>
    </header>

    <!-- Hero Card: Full container width, grey background, radius-2, priority -->
    <div class="mt-8 md:mt-12 w-full">
      <DemoMedia
        name={study.hero}
        alt={study.heroAlt}
        variant="card"
        radius="radius-2"
        priority={true}
      />
    </div>

    <!-- Blocks Section: 112px spacing desktop, 72px mobile -->
    <div class="mt-16 md:mt-[112px] space-y-[72px] md:space-y-[112px]">
      {
        study.blocks.map((block) => {
          if (block.type === 'text') {
            return (
              <section class="w-full max-w-[590px] mx-auto text-left">
                <h2
                  class:list={[
                    'text-[18px] md:text-[20px] font-medium text-[#000000] leading-snug',
                    block.uppercase ? 'uppercase tracking-[0.02em]' : '',
                  ]}
                >
                  {block.heading}
                </h2>
                <div class="mt-4 md:mt-5 space-y-4">
                  {block.paragraphs.map((p) => (
                    <p class="text-[14px] leading-[1.5] text-[#262626] font-normal">
                      {p}
                    </p>
                  ))}
                </div>
              </section>
            );
          }

          if (block.type === 'media') {
            return (
              <section class="w-full flex justify-center">
                <DemoMedia
                  name={block.media}
                  alt={block.alt}
                  variant="bare"
                  displayWidth={block.displayWidth}
                />
              </section>
            );
          }

          if (block.type === 'split') {
            const isMediaLeft = block.side === 'media-left';
            return (
              <section class="w-full">
                <div class="flex flex-col md:flex-row items-center justify-between gap-8 md:gap-[80px]">
                  {/* Media column: always order-1 on mobile */}
                  <div
                    class:list={[
                      'w-full md:flex-1 flex items-center justify-center',
                      isMediaLeft ? 'order-1 md:order-1' : 'order-1 md:order-2',
                    ]}
                  >
                    <DemoMedia
                      name={block.media}
                      alt={block.alt}
                      variant="bare"
                      displayWidth={block.displayWidth}
                    />
                  </div>

                  {/* Text column: always order-2 on mobile */}
                  <div
                    class:list={[
                      'w-full max-w-[420px] flex flex-col justify-center text-left',
                      isMediaLeft ? 'order-2 md:order-2' : 'order-2 md:order-1',
                    ]}
                  >
                    <h2 class="text-[18px] md:text-[20px] font-medium text-[#000000] leading-snug">
                      {block.heading}
                    </h2>
                    <p class="mt-3 md:mt-4 text-[14px] leading-[1.5] text-[#262626] font-normal">
                      {block.body}
                    </p>
                  </div>
                </div>
              </section>
            );
          }

          if (block.type === 'grid') {
            // Pair items into rows of two (1-2, 3-4, etc.)
            const pairs: { media: string; alt: string }[][] = [];
            for (let i = 0; i < block.items.length; i += 2) {
              pairs.push(block.items.slice(i, i + 2));
            }

            return (
              <section class="w-full space-y-[18px]">
                {pairs.map((row) => (
                  <div class="flex flex-col md:flex-row gap-[18px] w-full items-stretch">
                    {row.map((item) => {
                      const itemMeta = manifest[item.media];
                      const ratio =
                        itemMeta?.width && itemMeta?.height
                          ? itemMeta.width / itemMeta.height
                          : 1;
                      return (
                        <div
                          class="w-full md:w-auto"
                          style={`flex-grow: ${ratio}; flex-basis: 0; min-width: 0;`}
                        >
                          <DemoMedia
                            name={item.media}
                            alt={item.alt}
                            variant="card"
                            radius="radius-2"
                            class="w-full h-full"
                          />
                        </div>
                      );
                    })}
                  </div>
                ))}
              </section>
            );
          }

          return null;
        })
      }
    </div>

    <!-- Case Study Footer -->
    <Footer variant="case" class="mt-[72px] md:mt-[112px]" />
  </main>
</Layout>