---
import rawManifest from '../data/media-manifest.json';
import { allCaseStudies } from '../data/caseStudies';

interface ManifestItem {
  type: 'video' | 'image';
  width: number;
  height: number;
  poster: string;
  mp4?: string;
  webm?: string;
}

const manifest = rawManifest as Record<string, ManifestItem>;

interface Props {
  name?: string;
  alt?: string;
  variant?: 'card' | 'bare';
  displayWidth?: number;
  radius?: 'radius-1' | 'radius-2' | string;
  priority?: boolean;
  poster?: string;
  video?: string | { mp4?: string; webm?: string } | null;
  aspect?: string;
  preload?: 'auto' | 'metadata' | 'none';
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  class?: string;
}

const {
  name,
  alt = 'Showcase media',
  variant = 'card',
  displayWidth,
  radius = 'radius-2',
  priority = false,
  poster: explicitPoster,
  video: explicitVideo = null,
  aspect: explicitAspect,
  preload: explicitPreload,
  loading: explicitLoading,
  fetchpriority: explicitFetchPriority,
  class: className = '',
} = Astro.props;

// Determine priority / loading defaults
const loading = explicitLoading ?? (priority ? 'eager' : 'lazy');
const fetchpriority = explicitFetchPriority ?? (priority ? 'high' : 'auto');

// Lookup in manifest if name prop given
let item: ManifestItem | null = null;
let isMissing = false;

if (name) {
  item = manifest[name] ?? null;
  if (!item) {
    isMissing = true;

    // Discover all missing media across case studies for a complete, actionable error
    const missingItems: string[] = [];
    for (const study of allCaseStudies) {
      if (study.hero && !manifest[study.hero]) {
        missingItems.push(`${study.slug} (hero: "${study.hero}")`);
      }
      for (const block of study.blocks) {
        if (block.type === 'media' && !manifest[block.media]) {
          missingItems.push(`${study.slug} (media: "${block.media}")`);
        } else if (block.type === 'split' && !manifest[block.media]) {
          missingItems.push(`${study.slug} (split: "${block.media}")`);
        } else if (block.type === 'grid') {
          for (const gridItem of block.items) {
            if (!manifest[gridItem.media]) {
              missingItems.push(`${study.slug} (grid: "${gridItem.media}")`);
            }
          }
        }
      }
    }

    const uniqueMissing = Array.from(new Set(missingItems.length > 0 ? missingItems : [`"${name}"`]));
    const errorMessage = `[DemoMedia] Missing media in manifest (${uniqueMissing.length} missing):\n - ${uniqueMissing.join('\n - ')}`;

    if (import.meta.env.PROD) {
      if (process.env.ALLOW_MISSING_MEDIA === '1') {
        console.warn(`[DemoMedia Warning] (ALLOW_MISSING_MEDIA=1 active): ${errorMessage}`);
      } else {
        throw new Error(`${errorMessage}\nSet ALLOW_MISSING_MEDIA=1 in environment variables if you want to bypass this check.`);
      }
    } else {
      console.warn(`[DemoMedia DEV Warning] ${errorMessage}`);
    }
  }
}

// Determine media type & URLs
let isVideo = false;
let effectivePoster = explicitPoster ?? '';
let webmSrc: string | null = null;
let mp4Src: string | null = null;
let intrinsicAspect = explicitAspect === 'none' ? undefined : explicitAspect;
let mediaWidth: number | undefined;
let mediaHeight: number | undefined;

if (item) {
  isVideo = item.type === 'video';
  effectivePoster = item.poster;
  webmSrc = item.webm ?? null;
  mp4Src = item.mp4 ?? null;
  mediaWidth = item.width;
  mediaHeight = item.height;
  if (explicitAspect !== 'none' && !explicitAspect && item.width && item.height) {
    intrinsicAspect = `${item.width} / ${item.height}`;
  }
} else if (!isMissing && explicitPoster) {
  // Legacy props from homepage
  effectivePoster = explicitPoster;
  if (typeof explicitVideo === 'string' && explicitVideo.trim() !== '') {
    if (explicitVideo.endsWith('.webm')) {
      webmSrc = explicitVideo;
      mp4Src = explicitVideo.replace(/\.webm$/, '.mp4');
    } else if (explicitVideo.endsWith('.mp4')) {
      webmSrc = explicitVideo.replace(/\.mp4$/, '.webm');
      mp4Src = explicitVideo;
    } else {
      webmSrc = `${explicitVideo}.webm`;
      mp4Src = `${explicitVideo}.mp4`;
    }
  } else if (explicitVideo && typeof explicitVideo === 'object') {
    webmSrc = explicitVideo.webm ?? null;
    mp4Src = explicitVideo.mp4 ?? null;
  }
  isVideo = Boolean(webmSrc || mp4Src);
}

const radiusClass =
  variant === 'card'
    ? radius === 'radius-1'
      ? 'rounded-[8px]'
      : radius === 'radius-2'
        ? 'rounded-[12px]'
        : radius
    : '';

const webpPoster = effectivePoster ? effectivePoster.replace(/\.png$/, '.webp') : '';

// Video preload: auto for videos near top/priority, metadata for others
const videoPreload = explicitPreload ?? (priority ? 'auto' : 'metadata');

// Container styles
const containerStyles: Record<string, string> = {};
if (intrinsicAspect) {
  containerStyles['aspect-ratio'] = intrinsicAspect;
}
if (displayWidth) {
  containerStyles['max-width'] = `${displayWidth}px`;
}
const styleString = Object.entries(containerStyles)
  .map(([k, v]) => `${k}: ${v};`)
  .join(' ');
---

{
  isMissing ? (
    <div
      class:list={[
        'demo-media-placeholder flex items-center justify-center bg-[#F1F1F1] text-[#737373] text-[13px] border border-dashed border-[#D4D4D4] mx-auto w-full',
        variant === 'card' ? 'rounded-[12px]' : 'rounded-[8px]',
        className,
      ]}
      style={styleString || 'aspect-ratio: 16/9;'}
      aria-label={import.meta.env.DEV ? `Missing media: ${name}` : undefined}
    >
      {import.meta.env.DEV && (
        <span class="px-4 py-2 text-center select-none font-mono opacity-80">
          [Media: {name}]
        </span>
      )}
    </div>
  ) : variant === 'bare' ? (
    <div
      class:list={[
        'demo-media-container relative w-full mx-auto overflow-hidden',
        className,
      ]}
      style={styleString}
    >
      {isVideo ? (
        <>
          <picture class="demo-media-poster w-full h-auto block hidden">
            {webpPoster && <source srcset={webpPoster} type="image/webp" />}
            <img
              src={effectivePoster}
              alt={alt}
              width={mediaWidth}
              height={mediaHeight}
              loading={loading}
              fetchpriority={fetchpriority}
              decoding={loading === 'eager' ? 'sync' : 'async'}
              class="w-full h-auto block"
            />
          </picture>
          <video
            autoplay
            muted
            loop
            playsinline
            preload={videoPreload}
            poster={effectivePoster}
            disablepictureinpicture
            class="demo-media-video w-full h-auto block"
            aria-label={alt}
          >
            {webmSrc && <source src={webmSrc} type="video/webm" />}
            {mp4Src && <source src={mp4Src} type="video/mp4" />}
            <img
              src={effectivePoster}
              alt={alt}
              width={mediaWidth}
              height={mediaHeight}
              loading={loading}
              decoding="async"
              class="w-full h-auto block"
            />
          </video>
        </>
      ) : (
        <picture class="w-full h-auto block">
          {webpPoster && <source srcset={webpPoster} type="image/webp" />}
          <img
            src={effectivePoster}
            alt={alt}
            width={mediaWidth}
            height={mediaHeight}
            loading={loading}
            fetchpriority={fetchpriority}
            decoding={loading === 'eager' ? 'sync' : 'async'}
            class="w-full h-auto block"
          />
        </picture>
      )}
    </div>
  ) : (
    <div
      class:list={[
        'demo-media-container relative w-full overflow-hidden bg-[#F1F1F1]',
        radiusClass,
        className,
      ]}
      style={styleString}
    >
      {isVideo ? (
        <>
          <picture class="demo-media-poster w-full h-full object-cover hidden">
            {webpPoster && <source srcset={webpPoster} type="image/webp" />}
            <img
              src={effectivePoster}
              alt={alt}
              width={mediaWidth}
              height={mediaHeight}
              loading={loading}
              fetchpriority={fetchpriority}
              decoding={loading === 'eager' ? 'sync' : 'async'}
              class="w-full h-full object-cover"
            />
          </picture>
          <video
            autoplay
            muted
            loop
            playsinline
            preload={videoPreload}
            poster={effectivePoster}
            disablepictureinpicture
            class="demo-media-video w-full h-full object-cover block transition-transform duration-500 ease-out group-hover:scale-[1.015]"
            aria-label={alt}
          >
            {webmSrc && <source src={webmSrc} type="video/webm" />}
            {mp4Src && <source src={mp4Src} type="video/mp4" />}
            <img
              src={effectivePoster}
              alt={alt}
              width={mediaWidth}
              height={mediaHeight}
              loading={loading}
              decoding="async"
              class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.015]"
            />
          </video>
        </>
      ) : (
        <picture class="w-full h-full block">
          {webpPoster && <source srcset={webpPoster} type="image/webp" />}
          <img
            src={effectivePoster}
            alt={alt}
            width={mediaWidth}
            height={mediaHeight}
            loading={loading}
            fetchpriority={fetchpriority}
            decoding={loading === 'eager' ? 'sync' : 'async'}
            class="w-full h-full object-cover block transition-transform duration-500 ease-out group-hover:scale-[1.015]"
          />
        </picture>
      )}
    </div>
  )
}

<style>
  @media (prefers-reduced-motion: reduce) {
    .demo-media-video {
      display: none !important;
    }
    .demo-media-poster {
      display: block !important;
    }
  }
</style>

<script>
  function setupDemoVideos() {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const containers = document.querySelectorAll<HTMLElement>('.demo-media-container');

    // Global interaction fallback set for videos that need user gesture due to policy
    let hasUserInteracted = false;
    const pendingPlayVideos = new Set<HTMLVideoElement>();

    function onUserInteraction() {
      if (hasUserInteracted) return;
      hasUserInteracted = true;
      pendingPlayVideos.forEach((video) => {
        if (!video.paused) {
          pendingPlayVideos.delete(video);
          return;
        }
        video.muted = true;
        video.play().then(() => {
          pendingPlayVideos.delete(video);
        }).catch(() => {});
      });
      ['pointerdown', 'touchstart', 'scroll', 'keydown'].forEach((evt) => {
        window.removeEventListener(evt, onUserInteraction, { capture: true });
      });
    }

    ['pointerdown', 'touchstart', 'scroll', 'keydown'].forEach((evt) => {
      window.addEventListener(evt, onUserInteraction, { capture: true, once: true });
    });

    containers.forEach((container) => {
      const video = container.querySelector<HTMLVideoElement>('video.demo-media-video');
      const poster = container.querySelector<HTMLElement>('.demo-media-poster');

      if (!video) return;

      // Ensure required DOM properties for automatic playback
      video.muted = true;
      video.defaultMuted = true;
      video.playsInline = true;
      video.loop = true;
      video.controls = false;
      video.disablePictureInPicture = true;
      if ('disableRemotePlayback' in video) {
        (video as any).disableRemotePlayback = true;
      }

      // Check if video is within one viewport height of the top
      const rect = video.getBoundingClientRect();
      if (rect.top < window.innerHeight) {
        video.preload = 'auto';
      }

      // Keep prefers-reduced-motion: reduce behavior intact
      if (prefersReducedMotion) {
        video.pause();
        video.removeAttribute('autoplay');
        video.style.display = 'none';
        if (poster) {
          poster.style.display = 'block';
        }
        return;
      }

      let isNearOrInView = false;

      function attemptPlay() {
        if (prefersReducedMotion || !isNearOrInView) return;
        video.muted = true;
        const playPromise = video.play();
        if (playPromise !== undefined) {
          playPromise.catch((err) => {
            if (import.meta.env.DEV) {
              console.warn('[DemoMedia] play() rejected:', video.src || video.currentSrc, err);
            }
            pendingPlayVideos.add(video);
          });
        }
      }

      // IntersectionObserver with rootMargin "300px"
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              isNearOrInView = entry.isIntersecting;
              if (entry.isIntersecting) {
                attemptPlay();
              } else {
                video.pause();
              }
            });
          },
          { rootMargin: '300px' }
        );
        observer.observe(video);
      } else {
        isNearOrInView = true;
        attemptPlay();
      }

      // Call play() again on loadeddata, canplay, visibilitychange and pageshow
      video.addEventListener('loadeddata', attemptPlay);
      video.addEventListener('canplay', attemptPlay);

      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'visible') {
          if (isNearOrInView) {
            attemptPlay();
          }
        } else {
          video.pause();
        }
      });

      window.addEventListener('pageshow', (e) => {
        if (e.persisted && isNearOrInView) {
          attemptPlay();
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupDemoVideos);
  } else {
    setupDemoVideos();
  }
  document.addEventListener('astro:page-load', setupDemoVideos);
</script>